# Local-only example values. Copy to .env (git-ignored) and replace with real
# credentials for any non-local use. Never commit a filled-in .env.
#
# Both URLs point at the Compose PostgreSQL service; DIRECT_URL is the direct
# (non-pooled) connection used by the pinned Prisma migration CLI, while
# DATABASE_URL is the pooled runtime connection used by PrismaService.

DATABASE_URL=postgresql://ecom:ecom_local_dev@postgres:5432/ecom_dev
DIRECT_URL=postgresql://ecom:ecom_local_dev@postgres:5432/ecom_dev

# Clerk placeholders — replace with a Clerk test instance for browser journeys.
CLERK_SECRET_KEY=sk_test_local_placeholder
CLERK_JWT_KEY=local_dev_jwt_key_placeholder
CLERK_WEB_ORIGIN=http://localhost:3000

# Verified-email allowlist that bootstraps platform-admin on first sign-in.
ADMIN_EMAILS=owner@example.test

# Server-side HMAC secret for the permanent keyed tombstone (Plan 03 decision).
TOMBSTONE_SECRET=local_dev_tombstone_secret_change_me
